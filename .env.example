# Copy to .env and fill in.

# Hostname Traefik routes to the harness, e.g. harness.home.example.com
HARNESS_HOST=harness.home.example.com

# Your auth-proxy username(s), comma separated.
HARNESS_ALLOWED_USERS=matt

# Optional: also require membership of this group.
HARNESS_REQUIRED_GROUP=

# Traefik's IP on the shared Docker network, as a /32. Identity headers are only
# trusted on connections from this address. Find it with:
#   docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' traefik
HARNESS_TRUSTED_PROXIES=172.18.0.2/32

# The external Docker network Traefik is attached to.
TRAEFIK_NETWORK=proxy

# Traefik entrypoint and the forward-auth middleware(s), comma separated.
TRAEFIK_ENTRYPOINT=websecure
AUTH_MIDDLEWARE=authelia@docker

# Identity header names. These MUST be headers your auth proxy returns to
# Traefik, otherwise a browser can forge them.
# Authelia (defaults):
HARNESS_USER_HEADER=Remote-User
HARNESS_GROUPS_HEADER=Remote-Groups
HARNESS_EMAIL_HEADER=Remote-Email
# Authentik:
# HARNESS_USER_HEADER=X-authentik-username
# HARNESS_GROUPS_HEADER=X-authentik-groups
# HARNESS_EMAIL_HEADER=X-authentik-email
